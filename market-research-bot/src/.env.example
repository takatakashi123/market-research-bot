# ローカル実行用。.env にコピーして値を設定してください（.env はコミットしないこと）
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-opus-5-5

# 通知先: line | gmail | webhook
NOTIFY_CHANNEL=line

# --- NOTIFY_CHANNEL=line（LINE Messaging API） ---
LINE_CHANNEL_ACCESS_TOKEN=
# 送信先のユーザーID（U から始まる33文字）またはグループID（C から始まる）
LINE_TO=

# --- NOTIFY_CHANNEL=gmail ---
GMAIL_USER=yourname@gmail.com
# Googleアカウントで発行した16桁のアプリパスワード（通常のログインパスワードではない）
GMAIL_APP_PASSWORD=
# 送信先（カンマ区切りで複数可。省略すると GMAIL_USER 宛て）
MAIL_TO=

# --- NOTIFY_CHANNEL=webhook（Slack / Discord） ---
WEBHOOK_URL=
